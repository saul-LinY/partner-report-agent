{
  "$ref": "#/definitions/SessionFactUploadV1",
  "definitions": {
    "SessionFactUploadV1": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "object",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "matchMethod": {
              "type": "string",
              "enum": [
                "exact_root",
                "descendant_path",
                "path_discovered",
                "unassigned"
              ]
            },
            "rootFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rootName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "id",
            "matchMethod",
            "rootFingerprint"
          ],
          "additionalProperties": false
        },
        "sourceRevision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "sourceHash": {
          "type": "string",
          "minLength": 16
        },
        "fromTurnId": {
          "type": "string",
          "minLength": 1
        },
        "toTurnId": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceOccurredAt": {
          "$ref": "#/definitions/SessionFactUploadV1/properties/observedAt"
        },
        "status": {
          "type": "string",
          "enum": [
            "extracted",
            "failed_read",
            "failed_extract",
            "excluded"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "1.0"
              },
              "factId": {
                "type": "string",
                "minLength": 1
              },
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "sourceRevision": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "sourceHash": {
                "type": "string",
                "minLength": 16
              },
              "fromTurnId": {
                "type": "string",
                "minLength": 1
              },
              "toTurnId": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "projectHint": {
                "type": "string",
                "maxLength": 120
              },
              "status": {
                "type": "string",
                "enum": [
                  "discussion",
                  "planned",
                  "in_progress",
                  "awaiting_validation",
                  "completed",
                  "blocked",
                  "cancelled"
                ]
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                },
                "default": []
              },
              "outcomes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                },
                "default": []
              },
              "impact": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                },
                "default": []
              },
              "decisions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                },
                "default": []
              },
              "blockers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                },
                "default": []
              },
              "nextSteps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                },
                "default": []
              },
              "timeline": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "$ref": "#/definitions/SessionFactUploadV1/properties/facts/items/properties/status"
                    },
                    "occurredAt": {
                      "$ref": "#/definitions/SessionFactUploadV1/properties/observedAt"
                    },
                    "summary": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600
                    },
                    "evidenceTurnIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": []
                    }
                  },
                  "required": [
                    "status",
                    "occurredAt",
                    "summary"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "turnId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "occurredAt": {
                      "$ref": "#/definitions/SessionFactUploadV1/properties/observedAt"
                    },
                    "excerpt": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "excerptHash": {
                      "type": "string",
                      "minLength": 16
                    },
                    "redacted": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "turnId",
                    "occurredAt",
                    "excerptHash"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "completionSupport": {
                "type": "string",
                "enum": [
                  "evidence",
                  "uncertain"
                ]
              },
              "factOrigin": {
                "type": "string",
                "enum": [
                  "ai_extracted",
                  "partner_supplied"
                ]
              },
              "redactionSummary": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                },
                "default": {}
              },
              "production": {
                "type": "object",
                "properties": {
                  "skillVersion": {
                    "type": "string",
                    "enum": [
                      "partner-report-sync/0.2.0",
                      "partner-report-platform/0.2.0"
                    ]
                  },
                  "promptVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "schemaVersion": {
                    "type": "string",
                    "const": "1.0"
                  },
                  "producer": {
                    "type": "string",
                    "enum": [
                      "codex-skill",
                      "data-platform"
                    ]
                  },
                  "modelVersion": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "skillVersion",
                  "promptVersion",
                  "schemaVersion",
                  "producer"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schemaVersion",
              "factId",
              "sessionId",
              "sourceRevision",
              "sourceHash",
              "fromTurnId",
              "toTurnId",
              "title",
              "status",
              "timeline",
              "completionSupport",
              "factOrigin",
              "production"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sessionId",
        "project",
        "sourceRevision",
        "sourceHash",
        "fromTurnId",
        "toTurnId",
        "observedAt",
        "status",
        "facts"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
