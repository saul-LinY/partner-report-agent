{
  "$ref": "#/definitions/SessionContributionV1",
  "definitions": {
    "SessionContributionV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "periodKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sessionKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project": {
          "type": "object",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "matchMethod": {
              "type": "string",
              "enum": [
                "exact_root",
                "descendant_path",
                "path_discovered",
                "unassigned"
              ]
            },
            "rootFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rootName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "scopeKey": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "name",
            "matchMethod",
            "rootFingerprint"
          ],
          "additionalProperties": false
        },
        "activity": {
          "type": "object",
          "properties": {
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "endedAt": {
              "$ref": "#/definitions/SessionContributionV1/properties/activity/properties/startedAt"
            }
          },
          "required": [
            "startedAt",
            "endedAt"
          ],
          "additionalProperties": false
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "outcome",
                  "progress",
                  "decision",
                  "blocker",
                  "next_step"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            },
            "required": [
              "kind",
              "text",
              "confidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 40
        },
        "observedAt": {
          "$ref": "#/definitions/SessionContributionV1/properties/activity/properties/startedAt"
        },
        "production": {
          "type": "object",
          "properties": {
            "skillVersion": {
              "type": "string",
              "pattern": "^partner-report-(sync|platform)\\/(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
            },
            "promptVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "schemaVersion": {
              "type": "string",
              "const": "1.0"
            },
            "producer": {
              "type": "string",
              "enum": [
                "codex-skill",
                "data-platform"
              ]
            },
            "modelVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "skillVersion",
            "promptVersion",
            "schemaVersion",
            "producer"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "periodKey",
        "sessionKey",
        "contentHash",
        "project",
        "activity",
        "title",
        "summary",
        "contributions",
        "observedAt",
        "production"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
