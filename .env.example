DATABASE_URL=postgres://partner_report:partner_report@localhost:54329/partner_report
# LAN development: replace 172.20.10.14 with this Mac's current private IP.
API_HOST=172.20.10.14
API_PORT=4310
WEB_ORIGIN=http://172.20.10.14:4311
VITE_API_URL=http://172.20.10.14:4310
SESSION_COOKIE_SECURE=false
# Optional on a Partner device. The connect command also accepts --server.
PARTNER_REPORT_SERVER_URL=http://172.20.10.14:4310
BOOTSTRAP_ADMIN_EMAIL=saul@laien.io
BOOTSTRAP_ADMIN_PASSWORD=123456
BOOTSTRAP_DISPLAY_NAME=Saul
BOOTSTRAP_TEAM_NAME=Partner Report Pilot
PLUGIN_MIN_VERSION=0.2.0
# Required by the central Worker for cross-Session aggregation and Report generation.
# The gateway must expose an OpenAI-compatible /v1/responses endpoint.
MODEL_API_BASE_URL=http://172.20.10.14:11434
MODEL_API_KEY=
MODEL_REASONING_EFFORT=none
# Worker leases model jobs for this timeout plus a 60-second buffer.
MODEL_REQUEST_TIMEOUT_MS=240000
MODEL_MAX_OUTPUT_TOKENS=32768

# Optional Feishu enterprise self-built app. When both values are present, the
# API starts the long-connection callback gateway and the review outbox relay.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Set false only for a binding-only connectivity test. Production defaults true.
FEISHU_REVIEW_DELIVERY_ENABLED=true
